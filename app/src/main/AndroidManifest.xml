<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

	<!-- Network for model downloads -->
	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

	<!-- Playback capture (Android 10+) -->
	<uses-permission android:name="android.permission.RECORD_AUDIO" />
	<uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

	<!-- Foreground service types -->
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

	<!-- Overlay / Display -->
	<uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

	<!-- Storage for debug audio exports -->
	<uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
		android:maxSdkVersion="28" />

	<uses-feature android:name="android.software.media_projection" android:required="true" />

	<application
		android:name=".ClipLexApplication"
		android:allowBackup="false"
		android:dataExtractionRules="@xml/data_extraction_rules"
		android:fullBackupContent="false"
		android:icon="@mipmap/ic_launcher"
		android:label="@string/app_name"
		android:roundIcon="@mipmap/ic_launcher_round"
		android:supportsRtl="true"
		android:theme="@style/Theme.ClipLex">
		<uses-native-library android:name="libvndksupport.so" android:required="false" />
		<uses-native-library android:name="libOpenCL.so" android:required="false" />

		<!-- Main activity - entry point -->
		<activity
			android:name=".MainActivity"
			android:exported="true"
			android:launchMode="singleTask"
			android:theme="@style/Theme.ClipLex">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity>

		<!-- Foreground service for Capture -->
		<service
			android:name=".service.CaptureService"
			android:exported="false"
			android:foregroundServiceType="mediaProjection" />

		<!-- Overlay service (Phase 09) -->
		<service
			android:name=".overlay.OverlayService"
			android:exported="false" />

	</application>

</manifest>
