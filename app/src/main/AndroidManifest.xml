<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

 <!-- Permissions declared here. Requested at runtime when needed. -->

 <!-- Playback capture (Android 10+) -->
 <uses-permission android:name="android.permission.RECORD_AUDIO" />
 <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

 <!-- Foreground service -->
 <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
 <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
 <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

 <!-- Overlay / Display -->
 <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

 <!-- Storage for debug audio exports -->
 <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
 android:maxSdkVersion="28" />

 <application
 android:name=".LearnThisApplication"
 android:allowBackup="false"
 android:icon="@android:drawable/ic_menu_compass"
 android:label="@string/app_name"
 android:supportsRtl="true"
 android:theme="@style/Theme.LearnThis">

 <!-- Main activity - entry point -->
 <activity
 android:name=".MainActivity"
 android:exported="true"
 android:theme="@style/Theme.LearnThis">
 <intent-filter>
 <action android:name="android.intent.action.MAIN" />
 <category android:name="android.intent.category.LAUNCHER" />
 </intent-filter>
 </activity>

 <!-- Foreground service for Learning Mode -->
 <service
 android:name=".service.LearningForegroundService"
 android:exported="false"
 android:foregroundServiceType="microphone|dataSync" />

 </application>

</manifest>
